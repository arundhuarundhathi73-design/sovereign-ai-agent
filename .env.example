# Sovereign AI Agent - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# WALLET & PAYMENT CONFIGURATION
# ============================================

# Wallet provider: 'mock' (for testing) or 'stripe' (for production)
WALLET_PROVIDER=mock

# Stripe API Key (required if WALLET_PROVIDER=stripe)
# Get from: https://dashboard.stripe.com/apikeys
WALLET_API_KEY=

# Wallet currency
WALLET_CURRENCY=USD

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://agent_user:secure_password@localhost:5432/agent_db

# ============================================
# STRIPE WEBHOOK CONFIGURATION
# ============================================

# Stripe Webhook Secret (from Stripe Dashboard > Webhooks)
# Used to verify webhook signatures for payment events
STRIPE_WEBHOOK_SECRET=whsec_test_your_secret_here

# Stripe API Key (optional, for additional payment operations)
STRIPE_API_KEY=sk_test_your_key_here

# ============================================
# AGENT OPERATION THRESHOLDS
# ============================================

# Balance threshold below which the agent stops taking new tasks
LOW_BALANCE_THRESHOLD=10.0

# Balance threshold at which the agent initiates graceful shutdown
SHUTDOWN_BALANCE_THRESHOLD=2.0

# Daily operational budget limit
DAILY_BUDGET=100.0

# Minimum net profit required before spawning child agents
MIN_NET_PROFIT=500.0

# Initial funding allocated to each child agent
CHILD_SEED_FUNDING=50.0

# ============================================
# DEPLOYMENT & SECURITY
# ============================================

# Deployment environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Comma-separated list of allowed origins for CORS
# In production, specify your domain(s): https://yourdomain.com,https://app.yourdomain.com
# Use "*" only for local development
ALLOWED_ORIGINS=*
